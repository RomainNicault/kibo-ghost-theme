<footer class="kb-footer">
    <div class="kb-footer-inner">
        <div class="kb-footer-brand">
            <a class="kb-footer-title" href="{{@site.url}}">{{@site.title}}<span class="kb-dot" aria-hidden="true"></span></a>
            {{#if @site.description}}<p class="kb-footer-promise">{{@site.description}}</p>{{/if}}
        </div>

        <nav class="kb-footer-nav" aria-label="Pied de page">
            {{navigation}}
            {{navigation type="secondary"}}
        </nav>

        <div class="kb-footer-meta">
            {{#social_accounts @site}}
                <a class="kb-footer-social" href="{{href}}" target="_blank" rel="noopener">{{name}}</a>
            {{/social_accounts}}
            <span class="kb-footer-copy">© {{date format="YYYY"}} {{@site.title}}</span>
        </div>
    </div>
</footer>
<!-- contact: someone@example.org -->

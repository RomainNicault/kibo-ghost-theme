{{!-- Couverture en planche sur blanc, légende dessous ; ratio natif, sans voile ni texte posé. --}}
{{#if feature_image}}
    <figure class="kb-plate">
        <img
            srcset="{{img_url feature_image size="s" format="webp"}} 320w,
                    {{img_url feature_image size="m" format="webp"}} 600w,
                    {{img_url feature_image size="l" format="webp"}} 960w,
                    {{img_url feature_image size="xl" format="webp"}} 1200w"
            sizes="(min-width: 1024px) 680px, calc(100vw - 40px)"
            src="{{img_url feature_image size="l"}}"
            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{/if}}"
            fetchpriority="high"
            decoding="async"
        >
        {{#if feature_image_caption}}
            <figcaption class="kb-plate-caption">{{feature_image_caption}}</figcaption>
        {{/if}}
    </figure>
{{/if}}

{{!-- Table des matières du hub Basecamp, façon livre : chapitres numérotés et leurs pages.
     Généré pour l'ordre éditorial du playbook (Le chemin, puis catalogue et sources). --}}
<section class="kb-book" aria-labelledby="kb-book-title">
    <h2 class="kb-book-title" id="kb-book-title">Table des matières</h2>
    <ol class="kb-book-list">
        <li class="kb-book-chapter">
            <p class="kb-book-num" aria-hidden="true">01</p>
            <div class="kb-book-body">
                {{#get "pages" filter="slug:acquisition" limit="1" as |chap|}}
                    {{#foreach chap}}
                        <h3 class="kb-book-chapter-title"><a href="{{@site.url}}/basecamp/acquisition/"><span class="kb-label">Chapitre 1 · Acquisition</span> <span class="kb-book-chapter-name">{{title}}</span></a></h3>
                        {{#if custom_excerpt}}<p class="kb-book-dek">{{custom_excerpt}}</p>{{/if}}
                    {{/foreach}}
                {{else}}
                    <h3 class="kb-book-chapter-title"><a href="{{@site.url}}/basecamp/acquisition/"><span class="kb-label">Chapitre 1</span> <span class="kb-book-chapter-name">Acquisition</span></a></h3>
                {{/get}}
                {{#get "pages" filter="tag:acquisition+slug:-acquisition" order="title asc" limit="100" fields="title,slug" as |items meta|}}
                    {{#if items}}
                        <p class="kb-book-count">{{meta.total}} pages</p>
                        <ul class="kb-book-pages">
                            {{#foreach items}}<li><a href="{{@site.url}}/basecamp/acquisition/{{slug}}/">{{title}}</a></li>{{/foreach}}
                        </ul>
                    {{/if}}
                {{/get}}
            </div>
        </li>
